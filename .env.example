# Facebook Rental Crawler Environment Variables

# Facebook Group URL to crawl
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/YOUR_GROUP_ID

# MongoDB Connection String (optional)
DB_URL=mongodb://localhost:27017

# GitHub Personal Access Token for LLMParser (optional)
CLIENT_TOKEN=your_github_token_here

# Ollama LLM Server Configuration
LLM_SERVER_ADDRESS=http://localhost
LLM_SERVER_PORT=11434
